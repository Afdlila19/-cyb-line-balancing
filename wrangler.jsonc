{
  // Cloudflare Worker settings for CYB Line Balancing.
  "name": "cyb-line-balancing",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyb-data",
      // Replace with the Database ID shown on your cyb-data page in Cloudflare (D1 SQLite Database > cyb-data).
      "database_id": "38b8eaa1-bbe5-49b4-b6b5-b6562c417951"
    }
  ],
  "observability": { "enabled": true }
}
